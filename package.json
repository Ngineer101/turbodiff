{
	"name": "turbodiff",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run build:cockpit && vite dev",
		"build": "pnpm run build:cockpit && vite build",
		"deploy": "vite build && wrangler deploy",
		"check:types": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
		"build:cockpit": "esbuild src/client/cockpit-app.tsx --bundle --format=esm --splitting --outdir=public/cockpit --entry-names=app --chunk-names=chunks/[name]-[hash] --minify --jsx=automatic --define:process.env.NODE_ENV=\"\\\"production\\\"\""
	},
	"dependencies": {
		"@cloudflare/sandbox": "^0.12.4",
		"@flue/runtime": "^2.0.1",
		"@pierre/diffs": "^1.3.4",
		"agents": "^0.14.2",
		"hono": "^4.7.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@flue/cli": "^2.0.1",
		"@flue/vite": "^2.0.1",
		"@types/node": "^22.10.10",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"esbuild": "^0.28.1",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"wrangler": "^4.97.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "12.0.2",
			"onFail": "download"
		}
	}
}
