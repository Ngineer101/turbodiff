{
	"name": "turbodiff",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run build:app && vite dev",
		"dev:app": "vite build --watch --config vite.client.config.ts",
		"build": "pnpm run build:app && vite build",
		"deploy": "pnpm run build:app && vite build && wrangler deploy",
		"check:types": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
		"build:app": "vite build --config vite.client.config.ts"
	},
	"dependencies": {
		"@cloudflare/sandbox": "^0.12.4",
		"@flue/runtime": "^2.0.1",
		"@pierre/diffs": "^1.3.4",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-switch": "^1.3.7",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.22",
		"agents": "^0.14.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.7.0",
		"lucide-react": "^1.30.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@flue/cli": "^2.0.1",
		"@flue/vite": "^2.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.10.10",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"esbuild": "^0.28.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"wrangler": "^4.97.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "12.0.2",
			"onFail": "download"
		}
	}
}
