{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turbodiff",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-08",
  // Deployment-specific variables are managed in Cloudflare and retained
  // across deploys. See `.dev.vars.example` for the self-hosting checklist.
  // Keeping them out of this shared config prevents forks from inheriting
  // values that only make sense for turbodiff.dev.
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
  },
  "compatibility_flags": ["nodejs_compat"],
  // Permit preview URLs for manually uploaded Worker versions. Production
  // routing is configured independently from this switch.
  "preview_urls": true,
  // Workers Traces and invocation logs retain production execution evidence.
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // Workers AI binding for provider-backed application services.
  "ai": { "binding": "AI" },
  // Exposes the live Worker version (id/tag) to GET /version — see
  // https://developers.cloudflare.com/workers/configuration/version-metadata/
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // PostgreSQL application store. Production connections are pooled by
  // Hyperdrive; migrations use a direct DATABASE_URL
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://turbodiff:turbodiff@localhost:5432/turbodiff",
    },
  ],
  // Verification evidence (Phase 4): screenshots captured in the sandbox land
  // here and are served publicly via GET /artifacts/*. Create once per account:
  //   npx wrangler r2 bucket create turbodiff-artifacts
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "turbodiff-artifacts" }],
  // Git hosting for turbodiff-owned projects.
  // Named GIT_ARTIFACTS because ARTIFACTS is the R2 evidence bucket. The
  // namespace must match ARTIFACTS_NAMESPACE in src/integrations/git/provider.ts
  // and the triggers.events filters below. Requires the Artifacts closed beta
  // on this account.
  "artifacts": [{ "binding": "GIT_ARTIFACTS", "namespace": "turbodiff-repos" }],
  "dev": { "enable_containers": false },
  // Factory sandbox: repository-changing stages run
  // pinned OpenCode inside an isolated container. Local dev needs Docker.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // 8 GiB: oxlint with JS plugins (`vp lint`) reserves a ~6 GiB arena per
      // thread, which Linux refuses on a 4 GiB VM before linting anything.
      "instance_type": "standard-3",
      // Every sandbox id (per-repo gen--, review--, plan--, fix--, provision--, ...)
      // holds one instance for its whole sleepAfter keep-warm window, so the
      // cap must cover concurrent runs PLUS warm idlers. 5 deadlocked in
      // production: five healthy-idle containers starved a new plan run into
      // an opaque sandbox 500.
      "max_instances": 15,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "LiveUpdates", "name": "LIVE_UPDATES" },
    ],
  },
  "workflows": [
    {
      "binding": "FACTORY_STAGE_WORKFLOW",
      "name": "turbodiff-factory-stage",
      "class_name": "FactoryStageWorkflow",
    },
    {
      "binding": "ARTIFACTS_EVENTS_WORKFLOW",
      "name": "turbodiff-artifacts-events",
      "class_name": "ArtifactsEventsWorkflow",
    },
  ],
  // Durable factory transitions carry only persisted run identifiers.
  //   npx wrangler queues create turbodiff-factory
  "queues": {
    "producers": [{ "binding": "FACTORY_QUEUE", "queue": "turbodiff-factory" }],
    "consumers": [
      {
        "queue": "turbodiff-factory",
        "max_batch_size": 1,
        "max_retries": 1,
      },
    ],
  },
  // Polls for due automations (src/application/automations/poll.ts, `scheduled`
  // handler in src/cloudflare.ts). Per-tenant "run daily at 9am" schedules
  // aren't expressible as static Cron Triggers, so this fires often and the
  // handler itself finds and claims whatever's due — schedule precision is
  // bounded by this interval.
  "triggers": {
    "crons": ["*/15 * * * *"],
    // Artifacts event ingestion: the platform
    // starts one ArtifactsEventsWorkflow instance per matching event. No
    // repo_name filter — one entry covers every repo in the namespace,
    // including repos created after this deploy.
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "turbodiff-repos" },
        "targets": [{ "type": "workflow", "workflow_name": "turbodiff-artifacts-events" }],
      },
      {
        "type": "cf.artifacts.repo.deleted",
        "filter": { "namespace": "turbodiff-repos" },
        "targets": [{ "type": "workflow", "workflow_name": "turbodiff-artifacts-events" }],
      },
    ],
  },
  // Durable Object migrations are append-only deployment history.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FluePrReviewerAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v3", "new_sqlite_classes": ["LiveUpdates"] },
    { "tag": "v4", "new_sqlite_classes": ["FlueExplainerAgent"] },
    { "tag": "v5", "deleted_classes": ["FluePrReviewerAgent"] },
    { "tag": "v6", "deleted_classes": ["FlueExplainerAgent"] },
    { "tag": "v7", "new_sqlite_classes": ["DesignJob"] },
    { "tag": "v8", "deleted_classes": ["DesignJob"] },
  ],
}
