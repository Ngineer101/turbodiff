{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turbodiff-tests",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  // better-auth (src/integrations/auth/better-auth.ts) needs a base URL at construction;
  // secrets (SESSION_SECRET etc.) come from .dev.vars.
  "vars": {
    "PUBLIC_BASE_URL": "https://turbodiff.test",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00e793ecaf2c44b292e069861623dc3f",
      "localConnectionString": "postgres://turbodiff:turbodiff@localhost:5432/turbodiff",
    },
  ],
}
